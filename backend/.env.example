DJANGO_SECRET_KEY=replace-this-with-a-long-random-string
DJANGO_DEBUG=true

DB_NAME=cs308_db
DB_USER=your_postgres_username
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
# Optional: keep backend DB connections open for a short time in production.
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=true

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Invoice email delivery.
# If EMAIL_HOST_USER and EMAIL_HOST_PASSWORD are empty in DEBUG mode,
# Django prints invoice emails to the backend terminal instead of sending them.
# For Gmail, use an app password, not your regular account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=your_email@gmail.com
